## Math Utility File ##

fn abs:num;
    cm num 0;
        j l mul num -1;
    ret num;
end abs;

fn clamp:num:min:max;
    cm num min;
        j l db num min;
    cm num max;
        j g db num max;
    ret num;
end clamp;

fn factorial:n;
    cm n 1;
    j le ret 1;

    db prev n;
    sub prev 1;
    
    factorial prev;
    db prevFact RETF;

    mul prevFact n;
    ret prevFact;
    
    alw cl *prev;
    alw cl *prevFact;
end factorial;
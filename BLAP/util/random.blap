##
    To use this file in your program, do "use <path>/random.blap;"
##

db seed1 123456789;
db seed2 987654321;

db randInt:min:max;
    mul seed1 40014;
    mod seed1 2147483563;

    mul seed2 40692;
    mod seed2 2147483399;

    db combined seed1;
    sub combined seed2;
    mod combined 2147483562;

    cm combined 0;
    j l add combined 2147483562;

    db range max;
    sub range min;
    add range 1;

    db result combined;
    mod result range;
    add result min;

    ret result;
    alw cl *combined;
    alw cl *range;
    alw cl *result;
end randInt;

db randDec:min:max;
    mul seed1 40014;
    mod seed1 2147483563;

    mul seed2 40692;
    mod seed2 2147483399;

    db combined seed1;
    sub combined seed2;
    mod combined 2147483562;

    cm combined 0;
    j l add combined 2147483562;

    db normalized combined;
    div normalized 2147483562;

    db range max;
    sub range min;
    mul normalized range;
    add normalized min;

    ret normalized;
    alw cl *combined;
    alw cl *normalized;
    alw cl *range;
end randDec;